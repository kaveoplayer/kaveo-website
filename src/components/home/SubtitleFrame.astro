---
// The subtitles moment's visual: not a screenshot, a drawing — a letterboxed frame with a subtitle
// line, and the same line moved onto its timing and translated. To be replaced by a real capture once
// the app's look settles.
---

<figure class="kv-subs" aria-label="A subtitle line, synced and translated">
  <div class="kv-subs-frame">
    <p class="kv-subs-line">Excuse me, sir?</p>
    <p class="kv-subs-line kv-subs-line--alt" lang="it">Mi scusi, signore?</p>
  </div>
  <figcaption>
    <span class="kv-chip">OpenSubtitles</span>
    <span class="kv-chip kv-chip--on">Synced</span>
    <span class="kv-chip">Translated on this computer</span>
  </figcaption>
</figure>

<style>
  .kv-subs {
    margin: 0;
  }
  .kv-subs-frame {
    aspect-ratio: 2.35 / 1;
    border-radius: 12px;
    background: #000;
    border: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 0.25rem;
    padding: 1.5rem;
  }
  /* A subtitle is white on the picture whatever the site's theme. */
  .kv-subs-line {
    margin: 0;
    font-size: clamp(var(--sl-text-base), calc(0.5rem + 1.5vw), var(--sl-text-2xl));
    font-weight: 600;
    color: #f6f6f8;
    text-align: center;
  }
  .kv-subs-line--alt {
    color: #5eead4;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .kv-chip {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    padding: 0 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .kv-chip--on {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
</style>
