---
// The picture moment's visual: the player, cropped to the picture in a cinema frame, and the order a
// frame goes through the pipeline.
import { Image } from 'astro:assets';
import player from '../../assets/screenshots/interface-tour-player.webp';

const stages = ['Source', 'Upscaling', 'Downscaling', 'Output'];
---

<figure class="kv-player">
  <div class="kv-player-frame">
    <Image
      src={player}
      alt="A film playing in Kaveo, cropped to the picture"
      widths={[800, 1400]}
      sizes="(min-width: 72rem) 38rem, 100vw"
    />
  </div>
  <figcaption>
    <span class="kv-hdr">HDR</span>
    {
      stages.map((s, i) => (
        <>
          {i > 0 && <span class="kv-arrow" aria-hidden="true">→</span>}
          <span class:list={{ 'kv-stage-on': s === 'Upscaling' }}>{s === 'Upscaling' ? 'Upscaling · neural' : s}</span>
        </>
      ))
    }
  </figcaption>
</figure>

<style>
  .kv-player {
    margin: 0;
  }
  .kv-player-frame {
    aspect-ratio: 2.35 / 1;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }
  /* The screenshot is the whole player window; the picture is its middle 69 %, which a 2.35:1 frame
     centred on it shows alone. */
  .kv-player-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .kv-hdr {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-radius: 999rem;
    padding: 0 0.75rem;
    font-weight: 700;
  }
  .kv-arrow {
    color: var(--sl-color-gray-4);
  }
  .kv-stage-on {
    color: var(--sl-color-white);
    font-weight: 600;
  }
</style>
