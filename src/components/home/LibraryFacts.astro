---
// The library moment's visual: no screenshot (the app's look still changes), only what the library
// is made of.
const facts = [
  { name: 'Local folders', note: 'films, series and music, found by themselves' },
  { name: 'Jellyfin', note: 'optional — its titles join yours, your place in sync' },
  { name: 'TMDB', note: 'posters, plots and genres, once you give it a key' },
  { name: 'Sagas and categories', note: 'your own order, and the episodes you are missing' },
  { name: 'Private vault', note: 'encrypted — locked, its titles are not there at all' },
];
---

<ul class="kv-facts">
  {
    facts.map((f, i) => (
      <li>
        <span class="kv-facts-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="kv-facts-name">{f.name}</span>
        <span class="kv-facts-note">{f.note}</span>
      </li>
    ))
  }
</ul>

<style>
  .kv-facts {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-gray-6);
  }
  li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1rem 0;
  }
  li + li {
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .kv-facts-num {
    grid-row: span 2;
    font-family: var(--kv-font-display);
    font-weight: 600;
    color: var(--sl-color-accent-high);
  }
  .kv-facts-name {
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .kv-facts-note {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
