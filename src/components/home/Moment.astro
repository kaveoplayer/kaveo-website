---
// One of the landing's numbered moments: a kicker, a heading and the text (the default slot,
// written in Markdown in index.mdx so its links are checked), beside a visual (the `visual` slot).
interface Props {
  num: string;
  kicker: string;
  title: string;
  /** Put the visual first on wide screens. */
  flip?: boolean;
}

const { num, kicker, title, flip = false } = Astro.props;
---

<section class:list={['kv-moment', 'not-content', { 'kv-moment--flip': flip }]}>
  <div class="kv-moment-text">
    <p class="kv-kicker">{num} — {kicker}</p>
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="kv-moment-visual">
    <slot name="visual" />
  </div>
</section>

<style>
  .kv-moment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 4.5rem;
    padding-top: 7rem;
  }
  .kv-moment--flip {
    flex-direction: row-reverse;
  }
  .kv-moment-text {
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .kv-moment-visual {
    flex: 1.3 1 28rem;
    min-width: 0;
  }
  .kv-kicker {
    margin: 0;
    font-family: var(--kv-font-display);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-accent-high);
  }
  h2 {
    margin: 0;
    font-family: var(--kv-font-display);
    font-weight: 600;
    font-size: clamp(var(--sl-text-2xl), calc(1rem + 2vw), 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .kv-moment-text :global(p) {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .kv-moment-text :global(a) {
    font-weight: 600;
  }
</style>
