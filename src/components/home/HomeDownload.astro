---
// The landing's download block: the latest release, and what each system gets. The requirements are
// the Download page's, shortened; that page stays the reference.
import { LATEST_RELEASE_URL } from '../../../site.config.mjs';
import { sitePath } from '../../lib/links';

const systems = [
  {
    name: 'Linux',
    formats: ['.deb', '.rpm', 'AUR', 'Tarball', 'AppImage'],
    needs: 'x86_64 with glibc 2.35 or newer, on Wayland or X11, and a GPU with Vulkan 1.2.',
  },
  {
    name: 'Windows',
    formats: ['Installer', 'MSI', 'Portable'],
    needs: 'Windows 10 or 11, 64-bit (x64).',
  },
];
---

<section class="kv-download not-content" aria-labelledby="kv-download-title">
  <div class="kv-download-lead">
    <h2 id="kv-download-title">Download Kaveo</h2>
    <p>Every file on the release page has a SHA-256 checksum beside it.</p>
    <a class="kv-btn kv-btn--ink" href={LATEST_RELEASE_URL}>Latest release</a>
    {/* Remove once the first beta is published. */}
    <p class="kv-download-note">The first beta is not out yet — the release page is empty until then.</p>
  </div>
  {
    systems.map((s) => (
      <div class="kv-download-os">
        <h3>{s.name}</h3>
        <ul>
          {s.formats.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        <p>{s.needs}</p>
        <a href={sitePath('download/')}>Which one to pick</a>
      </div>
    ))
  }
</section>

<style>
  .kv-download {
    display: flex;
    flex-wrap: wrap;
    margin-top: 7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
  }
  .kv-download-lead {
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }
  .kv-download-lead h2 {
    margin: 0;
    font-family: var(--kv-font-display);
    font-weight: 600;
    font-size: var(--sl-text-4xl);
    line-height: 1.1;
    color: inherit;
  }
  .kv-download-lead p {
    margin: 0;
  }
  .kv-download-lead .kv-btn {
    align-self: flex-start;
    margin-top: auto;
  }
  .kv-download-note {
    font-size: var(--sl-text-xs);
  }
  .kv-download-os {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2.5rem;
  }
  .kv-download-os + .kv-download-os {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }
  .kv-download-os h3 {
    margin: 0;
    font-family: var(--kv-font-display);
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .kv-download-os ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kv-download-os li {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    padding: 0 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .kv-download-os p {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .kv-download-os a {
    margin-top: auto;
    font-weight: 600;
    font-size: var(--sl-text-sm);
  }
</style>
