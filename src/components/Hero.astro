---
// Starlight's Hero, overridden for the landing alone: every other page with a hero (the 404) keeps
// Starlight's own.
import Default from '@astrojs/starlight/components/Hero.astro';
import HomeHero from './home/HomeHero.astro';

const isHome = Astro.locals.starlightRoute.id === '';
---

{isHome ? <HomeHero /> : <Default />}
